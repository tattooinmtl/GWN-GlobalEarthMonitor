{
  "gwn": "1.0",
  "id": "asteroid-center",
  "name": "Asteroid Center",
  "icon": "*",
  "version": "2.1.0",
  "author": "GWN",
  "description": "Dedicated asteroid intelligence page with multi-source live feeds.",
  "permissions": [
    "network"
  ],
  "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"UTF-8\"/>\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\r\n<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self' 'unsafe-inline' blob: data: https:; connect-src https://ssd-api.jpl.nasa.gov https://api.nasa.gov https://www.minorplanetcenter.net https://ps1images.stsci.edu https://catalogs.mast.stsci.edu; img-src 'self' data: https:;\"/>\r\n<title>Asteroid Center</title>\r\n<style>\r\n*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}\r\n:root{--bg:#f0efe9;--card:#fff;--well:#e8e7e1;--text:#1a1a18;--muted:#6b6b67;--dim:#9b9b97;--border:rgba(0,0,0,.10);--border-md:rgba(0,0,0,.2);--danger:#a43d2b;--ok:#2b6e48;--r:10px;--font:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}\r\n@media(prefers-color-scheme:dark){:root{--bg:#181816;--card:#222220;--well:#2c2c29;--text:#f0efe9;--muted:#a0a09a;--dim:#666662;--border:rgba(255,255,255,.08);--border-md:rgba(255,255,255,.16);--danger:#ff947d;--ok:#78d7a0}}\r\nbody{font-family:var(--font);background:var(--bg);color:var(--text);padding:24px 20px 40px;max-width:1100px;margin:0 auto}\r\nh1{font-size:22px;font-weight:700;margin-bottom:4px}.sub{font-size:12px;color:var(--dim);margin-bottom:16px}.sec{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--dim);margin-bottom:9px}\r\n.card{background:var(--card);border:.5px solid var(--border);border-radius:12px;padding:14px;margin-bottom:14px}\r\n.btn-row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.btn{font-size:13px;padding:8px 14px;border-radius:8px;border:.5px solid var(--border-md);background:transparent;color:var(--text);cursor:pointer}.btn:hover{background:var(--well)}.btn:disabled{opacity:.55;cursor:wait}\r\n#status{font-size:12px;color:var(--dim)}#status.ok{color:var(--ok)}#status.error{color:var(--danger)}\r\n#filter-row{display:grid;grid-template-columns:1fr 180px 180px;gap:8px;margin-top:10px}\r\ninput,select{background:var(--card);border:.5px solid var(--border-md);border-radius:8px;color:var(--text);padding:8px 10px;font-size:12px}\r\n#layout{display:grid;grid-template-columns:360px 1fr;gap:12px;min-height:420px;margin-top:10px}\r\n#list-wrap,#detail-wrap{border:.5px solid var(--border);border-radius:var(--r);background:var(--card)}\r\n#list{list-style:none;max-height:520px;overflow:auto}\r\n.item{width:100%;text-align:left;border:none;background:transparent;color:var(--text);cursor:pointer;padding:10px 12px;border-bottom:.5px solid var(--border)}\r\n.item:hover,.item.active{background:var(--well)}.name{font-size:13px;font-weight:600}.meta{font-size:11px;color:var(--dim);margin-top:2px}\r\n#detail-wrap{padding:12px}#title{font-size:18px;font-weight:700;margin-bottom:2px}#source{font-size:12px;color:var(--dim);margin-bottom:6px}#extra{font-size:11px;color:var(--dim);margin-bottom:8px}\r\n.grid{display:grid;grid-template-columns:200px 1fr;gap:6px 10px;font-size:12px}.k{color:var(--dim)}.v{color:var(--text);word-break:break-word}\r\n#source-health{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px;margin-top:10px}.source-pill{border:.5px solid var(--border);border-radius:10px;padding:9px 10px;background:var(--card)}.source-pill-name{font-size:11px;color:var(--dim);text-transform:uppercase;letter-spacing:.06em}.source-pill-state{font-size:12px;font-weight:700;margin-top:4px}.source-pill.ok .source-pill-state{color:var(--ok)}.source-pill.error .source-pill-state{color:var(--danger)}\r\n@media(max-width:900px){#filter-row{grid-template-columns:1fr}#layout{grid-template-columns:1fr}#list{max-height:260px}}\r\n/* PS1 enrichment */\r\n.ps1-wrap{margin-top:10px;border:1px solid rgba(129,140,248,.25);border-radius:10px;padding:12px;background:linear-gradient(135deg,rgba(129,140,248,.06),transparent)}\r\n.ps1-wrap.hidden{display:none}\r\n.ps1-hdr{display:flex;align-items:center;gap:8px;margin-bottom:8px}.ps1-badge{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;padding:2px 8px;border-radius:999px;background:rgba(129,140,248,.15);color:#818cf8}.ps1-status{font-size:11px;color:var(--dim)}\r\n.ps1-body{display:flex;gap:12px;flex-wrap:wrap}\r\n.ps1-img-wrap{width:160px;height:160px;border-radius:10px;overflow:hidden;border:1px solid var(--border);background:#0a0f15;flex-shrink:0;position:relative}\r\n.ps1-img-wrap img{width:100%;height:100%;object-fit:cover}\r\n.ps1-img-wrap .ps1-ph{position:absolute;inset:0;display:grid;place-items:center;font-size:11px;color:var(--dim);text-align:center}\r\n.ps1-mags{display:flex;flex-direction:column;gap:6px;justify-content:center}\r\n.ps1-mag-badge{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:8px;border:1px solid;font-size:12px;font-weight:700;font-variant-numeric:tabular-nums}\r\n.ps1-mag-label{font-weight:800;font-size:10px;text-transform:uppercase;opacity:.8}\r\n.ps1-det{font-size:11px;color:var(--dim);margin-top:2px}\r\n</style>\r\n</head>\r\n<body>\r\n<h1>Asteroid Center</h1>\r\n<p class=\"sub\">Live asteroid intelligence from NASA CAD, NASA Sentry, NASA NeoWs, and MPC NEOCP.</p>\r\n<div class=\"card\">\r\n  <div class=\"btn-row\">\r\n    <button class=\"btn\" id=\"load-btn\" onclick=\"loadAll(true)\">Load all asteroid feeds</button>\r\n    <button class=\"btn\" id=\"reload-btn\" onclick=\"loadAll(true)\">Reload</button>\r\n    <span id=\"status\">No asteroid data loaded yet.</span>\r\n  </div>\r\n  <div id=\"filter-row\">\r\n    <input id=\"search\" type=\"text\" placeholder=\"Search asteroid name...\" />\r\n    <select id=\"source-filter\"><option value=\"all\">All sources</option><option value=\"NASA CAD\">NASA CAD</option><option value=\"NASA Sentry\">NASA Sentry</option><option value=\"NASA NeoWs\">NASA NeoWs</option><option value=\"MPC NEOCP\">MPC NEOCP</option></select>\r\n    <select id=\"sort\"><option value=\"risk\">Sort: Risk first</option><option value=\"distance\">Sort: Closest first</option><option value=\"name\">Sort: Name</option></select>\r\n  </div>\r\n  <div id=\"source-health\"></div>\r\n  <div id=\"layout\">\r\n    <div id=\"list-wrap\"><ul id=\"list\"></ul></div>\r\n    <div id=\"detail-wrap\"><div id=\"title\">Select an asteroid</div><div id=\"source\"></div><div id=\"extra\"></div><div id=\"grid\" class=\"grid\"></div><div id=\"ps1-wrap\" class=\"ps1-wrap hidden\"><div class=\"ps1-hdr\"><span class=\"ps1-badge\">Pan-STARRS</span><span id=\"ps1-status\" class=\"ps1-status\"></span></div><div class=\"ps1-body\"><div class=\"ps1-img-wrap\"><img id=\"ps1-img\" alt=\"PS1 sky\"/><div id=\"ps1-ph\" class=\"ps1-ph\">Loading…</div></div><div id=\"ps1-mags\" class=\"ps1-mags\"></div></div></div></div>\r\n  </div>\r\n</div>\r\n<script>\r\nfunction el(id){return document.getElementById(id)}\r\nconst FETCH_TIMEOUT_MS=15000\r\nlet rows=[];let selectedId=null;let enrichBusy=false;let lastLoadReport=[]\r\nfunction setStatus(message,kind=''){const node=el('status');node.textContent=message;node.className=kind||''}\r\nasync function fetchJson(url,src){const ctrl=new AbortController();const timer=setTimeout(()=>ctrl.abort(),FETCH_TIMEOUT_MS);try{const r=await fetch(url,{signal:ctrl.signal,headers:{Accept:'application/json'}});if(!r.ok)throw new Error(src+' HTTP '+r.status);return await r.json()}catch(err){if(err?.name==='AbortError')throw new Error(src+' timeout');throw err}finally{clearTimeout(timer)}}\r\nfunction renderSourceHealth(){const host=el('source-health');host.innerHTML=lastLoadReport.map(item=>`<div class=\"source-pill ${item.ok?'ok':'error'}\"><div class=\"source-pill-name\">${item.name}</div><div class=\"source-pill-state\">${item.ok?item.count+' loaded':item.message}</div></div>`).join('')}\r\nasync function fetchCad(){const s=new Date().toISOString().split('T')[0];const e=new Date(Date.now()+365*86400000).toISOString().split('T')[0];const d=await fetchJson('https://ssd-api.jpl.nasa.gov/cad.api?dist-max=1&sort=dist&limit=250&date-min='+s+'&date-max='+e,'NASA CAD');const a=Array.isArray(d?.data)?d.data:[];return a.map((r,i)=>{const name=r[0]||'Unknown';const dist=parseFloat(r[4]??NaN);const v=parseFloat(r[7]??NaN);const h=parseFloat(r[10]??NaN);return{id:'cad-'+i+'-'+name,source:'NASA CAD',name,distanceAU:Number.isFinite(dist)?dist:null,riskScore:0,sbdbLookup:name,meta:Number.isFinite(dist)?('Dist '+dist.toFixed(5)+' AU'):'Dist unknown',details:{'Source':'NASA CAD','Object name':name,'Close approach date':r[3]||'Unknown','Distance (AU)':Number.isFinite(dist)?dist.toFixed(6):'Unknown','Relative velocity (km/s)':Number.isFinite(v)?v.toFixed(3):'Unknown','Absolute magnitude H':Number.isFinite(h)?h.toFixed(2):'Unknown'}}})}\r\nasync function fetchSentry(){const d=await fetchJson('https://ssd-api.jpl.nasa.gov/sentry.api','NASA Sentry');const a=Array.isArray(d?.data)?d.data:[];return a.slice(0,300).map((o,i)=>{const name=o?.des||o?.fullname||'Unknown';const ip=parseFloat(o?.ip??o?.prob??NaN);const ps=parseFloat(o?.ps_max??NaN);return{id:'sentry-'+i+'-'+name,source:'NASA Sentry',name,distanceAU:null,riskScore:Number.isFinite(ip)?ip:0,sbdbLookup:name,meta:Number.isFinite(ip)?('IP '+ip.toExponential(2)):'IP unknown',details:{'Source':'NASA Sentry','Object name':name,'Impact probability':Number.isFinite(ip)?ip.toExponential(6):'Unknown','Palermo scale max':Number.isFinite(ps)?ps.toFixed(3):'Unknown','Impact date range':o?.range||'Unknown','Potential impact years':o?.n_imp||'Unknown'}}})}\r\nasync function fetchNeoWs(){const start=new Date();const end=new Date(Date.now()+6*86400000);const s=start.toISOString().split('T')[0];const e=end.toISOString().split('T')[0];const d=await fetchJson('https://api.nasa.gov/neo/rest/v1/feed?start_date='+s+'&end_date='+e+'&api_key=dhAW7YN0FhjazKlxUM6rCqhquUXgaY9k6WGuObuw','NASA NeoWs');const by=d?.near_earth_objects||{};const out=[];for(const day of Object.keys(by)){const list=Array.isArray(by[day])?by[day]:[];for(const o of list)out.push(o)}return out.slice(0,250).map((o,i)=>{const name=o?.name||'Unknown';const ca=Array.isArray(o?.close_approach_data)?o.close_approach_data[0]:null;const distAu=parseFloat(ca?.miss_distance?.astronomical??NaN);const distKm=parseFloat(ca?.miss_distance?.kilometers??NaN);const dm=o?.estimated_diameter?.meters;const dmin=parseFloat(dm?.estimated_diameter_min??NaN);const dmax=parseFloat(dm?.estimated_diameter_max??NaN);return{id:'neows-'+i+'-'+name,source:'NASA NeoWs',name,distanceAU:Number.isFinite(distAu)?distAu:null,riskScore:o?.is_potentially_hazardous_asteroid?1e-3:0,sbdbLookup:o?.id||name,meta:Number.isFinite(distAu)?('Dist '+distAu.toFixed(5)+' AU'):'Dist unknown',details:{'Source':'NASA NeoWs','Object name':name,'NASA NEO id':o?.id||'Unknown','Potentially hazardous':o?.is_potentially_hazardous_asteroid?'Yes':'No','Close approach date':ca?.close_approach_date||'Unknown','Distance (AU)':Number.isFinite(distAu)?distAu.toFixed(6):'Unknown','Distance (km)':Number.isFinite(distKm)?Math.round(distKm).toLocaleString():'Unknown','Estimated diameter min (m)':Number.isFinite(dmin)?dmin.toFixed(1):'Unknown','Estimated diameter max (m)':Number.isFinite(dmax)?dmax.toFixed(1):'Unknown'}}})}\r\nasync function fetchNeoWs(){const start=new Date();const end=new Date(Date.now()+6*86400000);const s=start.toISOString().split('T')[0];const e=end.toISOString().split('T')[0];const primaryUrl='https://api.nasa.gov/neo/rest/v1/feed?start_date='+s+'&end_date='+e+'&api_key=dhAW7YN0FhjazKlxUM6rCqhquUXgaY9k6WGuObuw';const fallbackUrl='https://api.nasa.gov/neo/rest/v1/feed?start_date='+s+'&end_date='+e+'&api_key=DEMO_KEY';let d;try{d=await fetchJson(primaryUrl,'NASA NeoWs')}catch(err){if(!/HTTP 403|HTTP 429/.test(String(err?.message||'')))throw err;d=await fetchJson(fallbackUrl,'NASA NeoWs fallback')}const by=d?.near_earth_objects||{};const out=[];for(const day of Object.keys(by)){const list=Array.isArray(by[day])?by[day]:[];for(const o of list)out.push(o)}return out.slice(0,250).map((o,i)=>{const name=o?.name||'Unknown';const ca=Array.isArray(o?.close_approach_data)?o.close_approach_data[0]:null;const distAu=parseFloat(ca?.miss_distance?.astronomical??NaN);const distKm=parseFloat(ca?.miss_distance?.kilometers??NaN);const dm=o?.estimated_diameter?.meters;const dmin=parseFloat(dm?.estimated_diameter_min??NaN);const dmax=parseFloat(dm?.estimated_diameter_max??NaN);return{id:'neows-'+i+'-'+name,source:'NASA NeoWs',name,distanceAU:Number.isFinite(distAu)?distAu:null,riskScore:o?.is_potentially_hazardous_asteroid?1e-3:0,sbdbLookup:o?.id||name,meta:Number.isFinite(distAu)?('Dist '+distAu.toFixed(5)+' AU'):'Dist unknown',details:{'Source':'NASA NeoWs','Object name':name,'NASA NEO id':o?.id||'Unknown','Potentially hazardous':o?.is_potentially_hazardous_asteroid?'Yes':'No','Close approach date':ca?.close_approach_date||'Unknown','Distance (AU)':Number.isFinite(distAu)?distAu.toFixed(6):'Unknown','Distance (km)':Number.isFinite(distKm)?Math.round(distKm).toLocaleString():'Unknown','Estimated diameter min (m)':Number.isFinite(dmin)?dmin.toFixed(1):'Unknown','Estimated diameter max (m)':Number.isFinite(dmax)?dmax.toFixed(1):'Unknown'}}})}\r\nasync function fetchMpc(){const a=await fetchJson('https://www.minorplanetcenter.net/Extended_Files/neocp.json','MPC NEOCP');const list=Array.isArray(a)?a:[];return list.slice(0,300).map((o,i)=>{const name=o?.Temp_Desig||o?.desig||o?.Designation||'Unknown';const sc=parseFloat(o?.Score??o?.score??NaN);const v=parseFloat(o?.V??o?.v??NaN);return{id:'mpc-'+i+'-'+name,source:'MPC NEOCP',name,distanceAU:null,riskScore:Number.isFinite(sc)?sc/100:0,sbdbLookup:name,meta:Number.isFinite(sc)?('Score '+sc.toFixed(1)):'Score unknown',details:{'Source':'MPC NEOCP','Temporary designation':name,'MPC score':Number.isFinite(sc)?sc.toFixed(1):'Unknown','Visual magnitude (V)':Number.isFinite(v)?v.toFixed(2):'Unknown','Observation arc':o?.Arc||o?.arc||'Unknown','Updated':o?.Updated||o?.updated||'Unknown'}}})}\r\nfunction filtered(){const src=el('source-filter').value;const q=(el('search').value||'').trim().toLowerCase();const mode=el('sort').value;let list=rows;if(src!=='all')list=list.filter(r=>r.source===src);if(q)list=list.filter(r=>(r.name||'').toLowerCase().includes(q));list=[...list];if(mode==='name'){list.sort((x,y)=>(x.name||'').localeCompare(y.name||''))}else if(mode==='distance'){list.sort((x,y)=>{const xv=Number.isFinite(x.distanceAU)?x.distanceAU:Number.POSITIVE_INFINITY;const yv=Number.isFinite(y.distanceAU)?y.distanceAU:Number.POSITIVE_INFINITY;return xv-yv})}else{list.sort((x,y)=>{const diff=(y.riskScore||0)-(x.riskScore||0);if(Math.abs(diff)>0)return diff;const xv=Number.isFinite(x.distanceAU)?x.distanceAU:Number.POSITIVE_INFINITY;const yv=Number.isFinite(y.distanceAU)?y.distanceAU:Number.POSITIVE_INFINITY;return xv-yv})}return list}\r\nfunction ensureSelected(list){if(!list.length){selectedId=null;return}if(!selectedId||!list.some(x=>x.id===selectedId))selectedId=list[0].id}\r\nfunction renderList(){const l=el('list');const list=filtered();ensureSelected(list);if(!list.length){l.innerHTML='<li style=\"padding:10px;color:var(--dim);font-size:12px;\">No asteroids for current filters.</li>';el('title').textContent='Select an asteroid';el('source').textContent='';el('extra').textContent='';el('grid').innerHTML='';return}l.innerHTML=list.map(x=>`<li><button class=\"item ${x.id===selectedId?'active':''}\" data-id=\"${x.id}\"><div class=\"name\">${x.name}</div><div class=\"meta\">${x.source} · ${x.meta}</div></button></li>`).join('');for(const b of l.querySelectorAll('.item')){b.addEventListener('click',()=>{selectedId=b.dataset.id;renderList();renderDetail()})}}\r\nasync function enrichSbdb(row){if(!row||!row.sbdbLookup||row.sbdbLoaded||enrichBusy)return;enrichBusy=true;try{const data=await fetchJson('https://ssd-api.jpl.nasa.gov/sbdb.api?sstr='+encodeURIComponent(row.sbdbLookup),'JPL SBDB');const obj=data?.object||{};const p=data?.phys_par||{};if(obj.fullname)row.details['SBDB full name']=obj.fullname;if(obj.des)row.details['SBDB designation']=obj.des;if(p.diameter)row.details['SBDB diameter (km)']=String(p.diameter);if(p.albedo)row.details['SBDB albedo']=String(p.albedo);row.sbdbLoaded=true;if(selectedId===row.id)renderDetail();void enrichPs1(row,data)}catch{}finally{enrichBusy=false}}\r\nconst ps1Cache=new Map()\r\nasync function getPs1ColorUrl(ra,dec,size){const k=ra.toFixed(5)+'_'+dec.toFixed(5);let files=ps1Cache.get(k);if(!files){const ctrl=new AbortController();const tid=setTimeout(()=>ctrl.abort(),12000);const r=await fetch('https://ps1images.stsci.edu/cgi-bin/ps1filenames.py?ra='+ra+'&dec='+dec+'&filters=gri&type=stack&sep=,',{signal:ctrl.signal});clearTimeout(tid);const t=await r.text();files={};t.trim().split('\\n').slice(1).forEach(l=>{const c=l.split(',');if(c.length>=8)files[c[4]?.trim()]=c[7]?.trim()});ps1Cache.set(k,files)}if(!files.r&&!files.g&&!files.i)return null;const p=['ra='+ra,'dec='+dec,'size='+(size||240),'format=jpg'];if(files.i)p.push('red='+encodeURIComponent(files.i));if(files.r)p.push('green='+encodeURIComponent(files.r));if(files.g)p.push('blue='+encodeURIComponent(files.g));return'https://ps1images.stsci.edu/cgi-bin/fitscut.cgi?'+p.join('&')}\r\nasync function fetchPs1Cat(ra,dec){const ctrl=new AbortController();const tid=setTimeout(()=>ctrl.abort(),12000);const r=await fetch('https://catalogs.mast.stsci.edu/api/v0.1/panstarrs/dr2/mean.json?ra='+ra+'&dec='+dec+'&radius=0.005&nDetections.gte=2&pagesize=1&columns=[objName,nDetections,gMeanPSFMag,rMeanPSFMag,iMeanPSFMag,zMeanPSFMag,yMeanPSFMag]',{signal:ctrl.signal});clearTimeout(tid);if(!r.ok)return null;const d=await r.json();if(!d?.info||!d?.data?.length)return null;const cols=d.info.map(c=>c.column_name);const row=d.data[0];const obj={};cols.forEach((k,i)=>{obj[k]=row[i]===-999||row[i]===-999.0?null:row[i]});return obj}\r\nasync function enrichPs1(row,sbdbData){const wrap=el('ps1-wrap'),img=el('ps1-img'),ph=el('ps1-ph'),st=el('ps1-status'),mags=el('ps1-mags');wrap.classList.add('hidden');const orb=sbdbData?.orbit?.elements;if(!orb)return;let a,e2,inc,om,w,ma;for(const x of orb){if(x.name==='a')a=parseFloat(x.value);if(x.name==='e')e2=parseFloat(x.value);if(x.name==='i')inc=parseFloat(x.value);if(x.name==='om')om=parseFloat(x.value);if(x.name==='w')w=parseFloat(x.value);if(x.name==='ma')ma=parseFloat(x.value)}\r\nif([a,e2,inc,om,w,ma].some(v=>!Number.isFinite(v)))return;const deg=Math.PI/180;inc*=deg;om*=deg;w*=deg;ma*=deg;let E=ma;for(let j=0;j<30;j++){E=E-(E-e2*Math.sin(E)-ma)/(1-e2*Math.cos(E))}const nu=2*Math.atan2(Math.sqrt(1+e2)*Math.sin(E/2),Math.sqrt(1-e2)*Math.cos(E/2));const r2=a*(1-e2*Math.cos(E));const xh=r2*(Math.cos(om)*Math.cos(w+nu)-Math.sin(om)*Math.sin(w+nu)*Math.cos(inc));const yh=r2*(Math.sin(om)*Math.cos(w+nu)+Math.cos(om)*Math.sin(w+nu)*Math.cos(inc));const zh=r2*Math.sin(w+nu)*Math.sin(inc);let ra=Math.atan2(yh,xh)/deg;if(ra<0)ra+=360;const dec=Math.atan2(zh,Math.sqrt(xh*xh+yh*yh))/deg;if(dec<-30){st.textContent='Below PS1 footprint';wrap.classList.remove('hidden');return}wrap.classList.remove('hidden');st.textContent='Loading…';img.style.display='none';ph.style.display='';ph.textContent='Loading sky image…';mags.innerHTML='';const myId=row.id;try{const[url,cat]=await Promise.all([getPs1ColorUrl(ra,dec,240).catch(()=>null),fetchPs1Cat(ra,dec).catch(()=>null)]);if(selectedId!==myId)return;if(url){img.src=url;img.onload=()=>{img.style.display='';ph.style.display='none'};img.onerror=()=>{ph.textContent='Image unavailable'}}else{ph.textContent='No image coverage'}if(cat){const bands=[{k:'gMeanPSFMag',l:'g',c:'#6366f1'},{k:'rMeanPSFMag',l:'r',c:'#22c55e'},{k:'iMeanPSFMag',l:'i',c:'#eab308'},{k:'zMeanPSFMag',l:'z',c:'#f97316'},{k:'yMeanPSFMag',l:'y',c:'#ef4444'}];mags.innerHTML=bands.map(b=>{const v=cat[b.k];const ok=v!=null&&v>-99;return ok?`<span class=\"ps1-mag-badge\" style=\"border-color:${b.c}40;background:${b.c}18;color:${b.c}\"><span class=\"ps1-mag-label\">${b.l}</span>${parseFloat(v).toFixed(2)}</span>`:''}).join('')+'<span class=\"ps1-det\">'+(cat.nDetections||'?')+' detections</span>';st.textContent='Nearest PS1 source'}else{st.textContent=url?'Image only — no catalog match':'No PS1 data'}}catch(err){if(selectedId===myId)st.textContent='PS1 error'}}\r\nfunction renderDetail(){const row=rows.find(x=>x.id===selectedId);if(!row)return;el('title').textContent=row.name;el('source').textContent=row.source;el('extra').textContent=Number.isFinite(row.distanceAU)?('Distance: '+row.distanceAU.toFixed(6)+' AU'):'Distance: Unknown';el('grid').innerHTML=Object.entries(row.details).map(([k,v])=>`<div class=\"k\">${k}</div><div class=\"v\">${v}</div>`).join('');el('ps1-wrap').classList.add('hidden');el('ps1-mags').innerHTML='';el('ps1-img').style.display='none';el('ps1-ph').style.display='';el('ps1-ph').textContent='';void enrichSbdb(row)}\r\nasync function loadAll(force=false){if(!force&&rows.length){const visible=filtered().length;setStatus('Loaded '+rows.length+' records ('+visible+' visible).','ok');return}const lb=el('load-btn'),rb=el('reload-btn');lb.disabled=true;rb.disabled=true;setStatus('Loading asteroid feeds...');const sources=[['NASA CAD',fetchCad],['NASA Sentry',fetchSentry],['NASA NeoWs',fetchNeoWs],['MPC NEOCP',fetchMpc]];const rs=await Promise.allSettled(sources.map(([,loader])=>loader()));const merged=[];const failures=[];lastLoadReport=rs.map((result,index)=>{const name=sources[index][0];if(result.status==='fulfilled'){merged.push(...result.value);return{name,ok:true,count:result.value.length,message:'ok'}}const message=result.reason?.message||'failed';failures.push(name);return{name,ok:false,count:0,message}});rows=merged;selectedId=null;renderSourceHealth();renderList();renderDetail();const visible=filtered().length;if(rows.length){setStatus(failures.length?('Loaded '+rows.length+' records ('+visible+' visible). Failed: '+failures.join(', ')):('Loaded '+rows.length+' records ('+visible+' visible) from 4 feeds.'),failures.length?'':'ok')}else{setStatus('No asteroid data loaded. '+(failures.length?('Sources failed: '+failures.join(', ')):''),'error')}lb.disabled=false;rb.disabled=false}\r\nfunction bind(){const onFilter=()=>{renderList();renderDetail();const visible=filtered().length;if(rows.length)setStatus('Loaded '+rows.length+' records ('+visible+' visible).','ok')};el('search').addEventListener('input',onFilter);el('source-filter').addEventListener('change',onFilter);el('sort').addEventListener('change',onFilter)}\r\nbind();void loadAll(true)\r\n</script>\r\n</body>\r\n</html>\r\n"
}