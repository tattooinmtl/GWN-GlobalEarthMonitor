{
  "gwn": "1.0",
  "id": "sky-explorer",
  "name": "Sky Explorer",
  "icon": "🔭",
  "version": "1.0.0",
  "author": "GWN",
  "description": "Pan-STARRS DR2 sky survey explorer with color imagery, photometry, and preset deep-sky objects.",
  "permissions": [
    "network"
  ],
  "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"UTF-8\"/>\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\r\n<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self' 'unsafe-inline' blob: data: https:; connect-src https://ps1images.stsci.edu https://catalogs.mast.stsci.edu https://mast.stsci.edu; img-src 'self' data: https:;\"/>\r\n<title>Sky Explorer — Pan-STARRS</title>\r\n<style>\r\n*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}\r\n:root{--bg:#f0efe9;--card:#fff;--well:#e8e7e1;--text:#1a1a18;--muted:#6b6b67;--dim:#9b9b97;--border:rgba(0,0,0,.10);--border-md:rgba(0,0,0,.2);--accent:#4f46e5;--accent-bg:rgba(79,70,229,.08);--accent-border:rgba(79,70,229,.25);--ok:#2b6e48;--danger:#a43d2b;--r:10px;--font:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}\r\n@media(prefers-color-scheme:dark){:root{--bg:#181816;--card:#222220;--well:#2c2c29;--text:#f0efe9;--muted:#a0a09a;--dim:#666662;--border:rgba(255,255,255,.08);--border-md:rgba(255,255,255,.16);--accent:#818cf8;--accent-bg:rgba(129,140,248,.1);--accent-border:rgba(129,140,248,.3);--ok:#78d7a0;--danger:#ff947d}}\r\nbody{font-family:var(--font);background:var(--bg);color:var(--text);padding:24px 20px 40px;max-width:1200px;margin:0 auto}\r\nh1{font-size:22px;font-weight:700;margin-bottom:4px}\r\n.sub{font-size:12px;color:var(--dim);margin-bottom:16px}\r\n.card{background:var(--card);border:.5px solid var(--border);border-radius:12px;padding:14px;margin-bottom:14px}\r\n\r\n/* Search area */\r\n.search-row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}\r\n.search-input{flex:1;min-width:220px;padding:9px 14px;border:.5px solid var(--border-md);border-radius:8px;background:var(--card);color:var(--text);font-size:13px}\r\n.search-input::placeholder{color:var(--dim)}\r\n.search-btn{padding:9px 18px;border-radius:8px;border:.5px solid var(--accent-border);background:var(--accent-bg);color:var(--accent);font-size:13px;font-weight:700;cursor:pointer;transition:background .15s}\r\n.search-btn:hover{background:var(--accent-border)}\r\n.search-btn:disabled{opacity:.5;cursor:wait}\r\n#search-status{font-size:12px;color:var(--dim);margin-left:4px}\r\n\r\n/* Presets */\r\n.presets{margin-top:10px}\r\n.presets-label{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--dim);margin-bottom:7px}\r\n.preset-grid{display:flex;flex-wrap:wrap;gap:6px}\r\n.preset-btn{padding:5px 12px;border-radius:999px;border:.5px solid var(--border-md);background:transparent;color:var(--text);font-size:11px;font-weight:600;cursor:pointer;transition:background .12s,border-color .12s}\r\n.preset-btn:hover{background:var(--well);border-color:var(--accent-border)}\r\n.preset-btn.active{background:var(--accent-bg);border-color:var(--accent-border);color:var(--accent)}\r\n\r\n/* Main layout */\r\n#layout{display:grid;grid-template-columns:340px 1fr;gap:14px;min-height:500px;margin-top:12px}\r\n\r\n/* List panel */\r\n#list-wrap{border:.5px solid var(--border);border-radius:var(--r);background:var(--card);overflow:hidden}\r\n#list-header{padding:10px 12px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--dim);border-bottom:.5px solid var(--border)}\r\n#list{list-style:none;max-height:560px;overflow:auto}\r\n.item{width:100%;text-align:left;border:none;background:transparent;color:var(--text);cursor:pointer;padding:10px 12px;border-bottom:.5px solid var(--border);transition:background .1s}\r\n.item:hover,.item.active{background:var(--well)}\r\n.item-name{font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\r\n.item-pos{font-size:11px;color:var(--dim);margin-top:2px;font-variant-numeric:tabular-nums}\r\n.item-det{font-size:10px;color:var(--muted);margin-top:3px}\r\n.item-mags{display:flex;gap:4px;margin-top:4px;flex-wrap:wrap}\r\n.item-mag{font-size:10px;padding:2px 6px;border-radius:6px;font-weight:700;font-variant-numeric:tabular-nums}\r\n\r\n/* Detail / preview panel */\r\n#detail-wrap{border:.5px solid var(--border);border-radius:var(--r);background:var(--card);padding:16px;display:flex;flex-direction:column;gap:12px}\r\n\r\n/* Image section */\r\n.img-section{display:flex;flex-direction:column;gap:8px}\r\n.img-main-wrap{position:relative;width:100%;max-width:480px;aspect-ratio:1/1;border-radius:12px;overflow:hidden;border:1px solid var(--border);background:#0a0f15}\r\n.img-main{width:100%;height:100%;object-fit:cover;display:block}\r\n.img-placeholder{position:absolute;inset:0;display:grid;place-items:center;font-size:13px;color:var(--dim);background:var(--well);text-align:center;padding:20px}\r\n.img-controls{display:flex;align-items:center;gap:10px}\r\n.img-controls label{font-size:11px;color:var(--dim)}\r\n.img-controls input[type=range]{flex:1;max-width:200px;accent-color:var(--accent)}\r\n.img-controls span{font-size:11px;color:var(--muted);min-width:50px}\r\n\r\n/* Filter thumbnails */\r\n.filter-row{display:flex;gap:6px;flex-wrap:wrap}\r\n.filter-thumb-wrap{display:flex;flex-direction:column;align-items:center;gap:3px}\r\n.filter-thumb{width:72px;height:72px;object-fit:cover;border-radius:8px;border:1px solid var(--border);cursor:pointer;transition:border-color .15s}\r\n.filter-thumb:hover{border-color:var(--accent)}\r\n.filter-label{font-size:10px;font-weight:700;color:var(--dim);text-transform:uppercase}\r\n\r\n/* Object info */\r\n.detail-title{font-size:18px;font-weight:700}\r\n.detail-pos{font-size:12px;color:var(--dim);margin-top:2px}\r\n.info-grid{display:grid;grid-template-columns:180px 1fr;gap:5px 10px;font-size:12px;margin-top:8px}\r\n.info-k{color:var(--dim)}.info-v{color:var(--text);word-break:break-word}\r\n\r\n/* Mag badges (detail) */\r\n.mag-row{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}\r\n.mag-badge{display:inline-flex;align-items:center;gap:5px;padding:5px 12px;border-radius:8px;border:1px solid;font-size:13px;font-weight:700;font-variant-numeric:tabular-nums}\r\n.mag-label{font-weight:800;font-size:10px;text-transform:uppercase;opacity:.8}\r\n.det-count{font-size:11px;color:var(--dim);margin-top:4px}\r\n\r\n/* Links */\r\n.ext-link{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:8px;border:.5px solid var(--accent-border);background:var(--accent-bg);color:var(--accent);font-size:12px;font-weight:700;text-decoration:none;cursor:pointer;transition:background .15s}\r\n.ext-link:hover{background:var(--accent-border)}\r\n\r\n/* Empty / loading states */\r\n.placeholder{display:grid;place-items:center;min-height:200px;font-size:13px;color:var(--dim);text-align:center;padding:20px}\r\n\r\n/* Responsive */\r\n@media(max-width:900px){\r\n  #layout{grid-template-columns:1fr}\r\n  #list{max-height:260px}\r\n  .img-main-wrap{max-width:100%}\r\n}\r\n</style>\r\n</head>\r\n<body>\r\n\r\n<h1>🔭 Sky Explorer — Pan-STARRS</h1>\r\n<p class=\"sub\">Search the Pan-STARRS DR2 sky survey. Browse 3 billion objects with color imagery across 3/4 of the sky.</p>\r\n\r\n<div class=\"card\">\r\n  <div class=\"search-row\">\r\n    <input id=\"search-input\" class=\"search-input\" type=\"text\" placeholder=\"Object name (e.g. Ring Nebula) or RA, Dec (e.g. 210.802, 54.349)\" />\r\n    <button id=\"search-btn\" class=\"search-btn\" onclick=\"doSearch()\">Search</button>\r\n    <span id=\"search-status\"></span>\r\n  </div>\r\n  <div class=\"presets\">\r\n    <div class=\"presets-label\">Quick presets</div>\r\n    <div class=\"preset-grid\" id=\"preset-grid\"></div>\r\n  </div>\r\n</div>\r\n\r\n<div id=\"layout\">\r\n  <div id=\"list-wrap\">\r\n    <div id=\"list-header\">Sources (0)</div>\r\n    <ul id=\"list\"></ul>\r\n  </div>\r\n  <div id=\"detail-wrap\">\r\n    <div class=\"placeholder\" id=\"detail-placeholder\">Search for an object or pick a preset to begin.</div>\r\n    <div id=\"detail-content\" style=\"display:none\">\r\n      <!-- Image section -->\r\n      <div class=\"img-section\">\r\n        <div class=\"img-main-wrap\" id=\"img-main-wrap\">\r\n          <img id=\"img-main\" class=\"img-main\" alt=\"Pan-STARRS color composite\" />\r\n          <div id=\"img-placeholder\" class=\"img-placeholder\">Loading sky image…</div>\r\n        </div>\r\n        <div class=\"img-controls\">\r\n          <label for=\"size-slider\">Cutout size</label>\r\n          <input id=\"size-slider\" type=\"range\" min=\"120\" max=\"1200\" step=\"60\" value=\"480\" />\r\n          <span id=\"size-label\">480px · 2′</span>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Filter thumbnails -->\r\n      <div>\r\n        <div style=\"font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--dim);margin-bottom:6px\">Individual Bands</div>\r\n        <div class=\"filter-row\" id=\"filter-row\"></div>\r\n      </div>\r\n\r\n      <!-- Info -->\r\n      <div>\r\n        <div class=\"detail-title\" id=\"detail-title\"></div>\r\n        <div class=\"detail-pos\" id=\"detail-pos\"></div>\r\n        <div class=\"mag-row\" id=\"detail-mags\"></div>\r\n        <div class=\"det-count\" id=\"detail-det\"></div>\r\n        <div class=\"info-grid\" id=\"detail-grid\"></div>\r\n      </div>\r\n\r\n      <!-- Links -->\r\n      <div style=\"display:flex;gap:8px;flex-wrap:wrap;margin-top:4px\">\r\n        <a id=\"link-cutout\" class=\"ext-link\" target=\"_blank\" rel=\"noopener\">🔗 View in PS1 Cutout Service</a>\r\n        <a id=\"link-catalog\" class=\"ext-link\" target=\"_blank\" rel=\"noopener\">📊 View in MAST Catalog</a>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<script>\r\n/* ---- Helpers ---- */\r\nfunction el(id){return document.getElementById(id)}\r\nfunction esc(s){const d=document.createElement('div');d.textContent=s;return d.innerHTML}\r\n\r\nconst TIMEOUT=15000\r\nconst BANDS=[\r\n  {key:'gMeanPSFMag',label:'g',color:'#6366f1'},\r\n  {key:'rMeanPSFMag',label:'r',color:'#22c55e'},\r\n  {key:'iMeanPSFMag',label:'i',color:'#eab308'},\r\n  {key:'zMeanPSFMag',label:'z',color:'#f97316'},\r\n  {key:'yMeanPSFMag',label:'y',color:'#ef4444'}\r\n]\r\n\r\nconst PRESETS=[\r\n  {name:'Andromeda (M31)',ra:10.6847,dec:41.2687},\r\n  {name:'Orion Nebula (M42)',ra:83.8221,dec:-5.3911},\r\n  {name:'Crab Nebula (M1)',ra:83.6331,dec:22.0145},\r\n  {name:'Ring Nebula (M57)',ra:283.3962,dec:33.0289},\r\n  {name:'Whirlpool (M51)',ra:202.4696,dec:47.1952},\r\n  {name:'Pleiades (M45)',ra:56.8711,dec:24.1050},\r\n  {name:'Eagle Nebula (M16)',ra:274.7000,dec:-13.8067},\r\n  {name:'Sombrero (M104)',ra:189.9976,dec:-11.6231},\r\n  {name:'Triangulum (M33)',ra:23.4621,dec:30.6602},\r\n  {name:'Horsehead Nebula',ra:85.2417,dec:-2.4583}\r\n]\r\n\r\nlet state={ra:null,dec:null,rows:[],selectedIdx:0,cutoutSize:480,imgCache:{},activePreset:null}\r\n\r\n/* ---- Render presets ---- */\r\nfunction renderPresets(){\r\n  el('preset-grid').innerHTML=PRESETS.map((p,i)=>\r\n    `<button class=\"preset-btn${state.activePreset===i?' active':''}\" data-idx=\"${i}\">${esc(p.name)}</button>`\r\n  ).join('')\r\n  el('preset-grid').querySelectorAll('.preset-btn').forEach(btn=>{\r\n    btn.addEventListener('click',()=>{\r\n      const idx=parseInt(btn.dataset.idx)\r\n      state.activePreset=idx\r\n      el('search-input').value=PRESETS[idx].name\r\n      searchByCoords(PRESETS[idx].ra,PRESETS[idx].dec)\r\n      renderPresets()\r\n    })\r\n  })\r\n}\r\nrenderPresets()\r\n\r\n/* ---- Search ---- */\r\nel('search-input').addEventListener('keydown',e=>{if(e.key==='Enter')doSearch()})\r\n\r\nasync function doSearch(){\r\n  const raw=el('search-input').value.trim()\r\n  if(!raw){setStatus('Enter an object name or coordinates.');return}\r\n  state.activePreset=null\r\n  renderPresets()\r\n\r\n  // Try parsing as \"ra, dec\"\r\n  const coordMatch=raw.match(/^\\s*([\\d.+-]+)\\s*[,\\s]+\\s*([\\d.+-]+)\\s*$/)\r\n  if(coordMatch){\r\n    const ra=parseFloat(coordMatch[1]),dec=parseFloat(coordMatch[2])\r\n    if(Number.isFinite(ra)&&Number.isFinite(dec)){\r\n      searchByCoords(ra,dec)\r\n      return\r\n    }\r\n  }\r\n  // Resolve name via MAST\r\n  await resolveAndSearch(raw)\r\n}\r\n\r\nasync function resolveAndSearch(name){\r\n  setStatus('Resolving \"'+name+'\"…')\r\n  disableSearch(true)\r\n  try{\r\n    const ctrl=new AbortController();const tid=setTimeout(()=>ctrl.abort(),TIMEOUT)\r\n    const r=await fetch('https://mast.stsci.edu/api/v0/invoke',{\r\n      method:'POST',signal:ctrl.signal,\r\n      headers:{'Content-Type':'application/x-www-form-urlencoded'},\r\n      body:'request='+encodeURIComponent(JSON.stringify({service:'Mast.Name.Lookup',params:{input:name,format:'json'}}))\r\n    })\r\n    clearTimeout(tid)\r\n    const d=await r.json()\r\n    const results=d?.resolvedCoordinate\r\n    if(!Array.isArray(results)||!results.length){setStatus('Could not resolve \"'+name+'\". Try coordinates instead.','error');disableSearch(false);return}\r\n    const ra=parseFloat(results[0].ra),dec=parseFloat(results[0].decl)\r\n    if(!Number.isFinite(ra)||!Number.isFinite(dec)){setStatus('Invalid coordinates from resolver.','error');disableSearch(false);return}\r\n    searchByCoords(ra,dec)\r\n  }catch(err){\r\n    setStatus('Resolver error: '+(err?.message||'unknown'),'error')\r\n  }finally{disableSearch(false)}\r\n}\r\n\r\nasync function searchByCoords(ra,dec){\r\n  state.ra=ra;state.dec=dec;state.selectedIdx=0\r\n  if(dec<-30){\r\n    setStatus('Dec '+dec.toFixed(4)+'° is outside Pan-STARRS footprint (dec > -30° only).','error')\r\n    state.rows=[];renderList();showPlaceholder('This position is below the Pan-STARRS survey footprint (dec must be > -30°).')\r\n    disableSearch(false)\r\n    return\r\n  }\r\n  setStatus('Searching RA '+ra.toFixed(4)+'° Dec '+dec.toFixed(4)+'°…')\r\n  disableSearch(true)\r\n  try{\r\n    const ctrl=new AbortController();const tid=setTimeout(()=>ctrl.abort(),TIMEOUT)\r\n    const url='https://catalogs.mast.stsci.edu/api/v0.1/panstarrs/dr2/mean.json?ra='+ra+'&dec='+dec+'&radius=0.05&nDetections.gte=2&pagesize=100&columns=[objName,raMean,decMean,nDetections,ng,nr,ni,nz,ny,gMeanPSFMag,rMeanPSFMag,iMeanPSFMag,zMeanPSFMag,yMeanPSFMag]&sort_by=distance.asc'\r\n    const r=await fetch(url,{signal:ctrl.signal})\r\n    clearTimeout(tid)\r\n    if(!r.ok)throw new Error('HTTP '+r.status)\r\n    const d=await r.json()\r\n    const cols=d?.info?.map(c=>c.column_name)||[]\r\n    state.rows=(d?.data||[]).map(row=>{const o={};cols.forEach((k,i)=>{o[k]=row[i]===-999||row[i]===-999.0?null:row[i]});return o})\r\n    setStatus(state.rows.length+' source'+(state.rows.length!==1?'s':'')+' found near RA '+ra.toFixed(4)+'° Dec '+dec.toFixed(4)+'°','ok')\r\n    renderList()\r\n    if(state.rows.length>0){state.selectedIdx=0;renderDetail()}\r\n    else showPlaceholder('No Pan-STARRS sources found within 3 arcmin of this position.')\r\n  }catch(err){\r\n    setStatus('Search failed: '+(err?.message||'unknown'),'error')\r\n    state.rows=[];renderList();showPlaceholder('Search failed. Check your connection and try again.')\r\n  }finally{disableSearch(false)}\r\n}\r\n\r\n/* ---- List ---- */\r\nfunction renderList(){\r\n  el('list-header').textContent='Sources ('+state.rows.length+')'\r\n  if(!state.rows.length){el('list').innerHTML='<li class=\"placeholder\" style=\"min-height:100px\">No results</li>';return}\r\n  el('list').innerHTML=state.rows.map((obj,i)=>{\r\n    const name=obj.objName||'PSO J'+pf(obj.raMean)+'+'+pf(obj.decMean)\r\n    const mags=BANDS.map(b=>{\r\n      const v=obj[b.key];const ok=v!=null&&v>-99\r\n      return ok?`<span class=\"item-mag\" style=\"background:${b.color}18;color:${b.color};border:1px solid ${b.color}35\">${b.label} ${parseFloat(v).toFixed(1)}</span>`:''\r\n    }).join('')\r\n    return `<li><button class=\"item${i===state.selectedIdx?' active':''}\" data-idx=\"${i}\">\r\n      <div class=\"item-name\">${esc(name)}</div>\r\n      <div class=\"item-pos\">RA ${pf(obj.raMean)}° Dec ${pf(obj.decMean)}°</div>\r\n      <div class=\"item-det\">${obj.nDetections||0} detections</div>\r\n      <div class=\"item-mags\">${mags}</div>\r\n    </button></li>`\r\n  }).join('')\r\n  el('list').querySelectorAll('.item').forEach(btn=>{\r\n    btn.addEventListener('click',()=>{\r\n      state.selectedIdx=parseInt(btn.dataset.idx)\r\n      renderList()\r\n      renderDetail()\r\n    })\r\n  })\r\n}\r\n\r\n/* ---- Detail ---- */\r\nasync function renderDetail(){\r\n  const obj=state.rows[state.selectedIdx]\r\n  if(!obj){showPlaceholder('Select a source from the list.');return}\r\n  el('detail-placeholder').style.display='none'\r\n  el('detail-content').style.display=''\r\n\r\n  const ra=parseFloat(obj.raMean),dec=parseFloat(obj.decMean)\r\n  const name=obj.objName||'PSO J'+pf(ra)+'+'+pf(dec)\r\n\r\n  el('detail-title').textContent=name\r\n  el('detail-pos').textContent='RA '+ra.toFixed(6)+'° · Dec '+dec.toFixed(6)+'°'\r\n\r\n  // Magnitudes\r\n  el('detail-mags').innerHTML=BANDS.map(b=>{\r\n    const v=obj[b.key];const display=v!=null&&v>-99?parseFloat(v).toFixed(2):'—'\r\n    return `<span class=\"mag-badge\" style=\"border-color:${b.color}40;background:${b.color}18;color:${b.color}\"><span class=\"mag-label\">${b.label}</span>${display}</span>`\r\n  }).join('')\r\n  el('detail-det').textContent=(obj.nDetections||'?')+' total detections (g:'+nn(obj.ng)+' r:'+nn(obj.nr)+' i:'+nn(obj.ni)+' z:'+nn(obj.nz)+' y:'+nn(obj.ny)+')'\r\n\r\n  // Info grid\r\n  const pairs=[\r\n    ['PS1 Name',name],\r\n    ['RA (mean)',ra.toFixed(6)+'°'],\r\n    ['Dec (mean)',dec.toFixed(6)+'°'],\r\n    ['Total detections',String(obj.nDetections||'?')]\r\n  ]\r\n  BANDS.forEach(b=>{const v=obj[b.key];pairs.push([b.label+'-band PSF mag',v!=null&&v>-99?parseFloat(v).toFixed(3):'—'])})\r\n  el('detail-grid').innerHTML=pairs.map(([k,v])=>`<div class=\"info-k\">${esc(k)}</div><div class=\"info-v\">${esc(v)}</div>`).join('')\r\n\r\n  // External links\r\n  el('link-cutout').href='https://ps1images.stsci.edu/cgi-bin/ps1cutouts?pos='+ra+'+'+dec+'&filter=color'\r\n  el('link-catalog').href='https://catalogs.mast.stsci.edu/?ra='+ra+'&dec='+dec+'&radius=0.05&mission=panstarrs'\r\n\r\n  // Load images\r\n  await loadImages(ra,dec)\r\n}\r\n\r\n/* ---- Images ---- */\r\nasync function loadImages(ra,dec){\r\n  const size=state.cutoutSize\r\n  const imgEl=el('img-main'),ph=el('img-placeholder')\r\n  imgEl.style.display='none';ph.style.display='';ph.textContent='Loading sky image…'\r\n  el('filter-row').innerHTML='<span style=\"font-size:11px;color:var(--dim)\">Loading bands…</span>'\r\n\r\n  // Fetch filenames\r\n  let files={}\r\n  try{\r\n    const key=ra.toFixed(5)+'_'+dec.toFixed(5)\r\n    if(state.imgCache[key]){files=state.imgCache[key]}\r\n    else{\r\n      const ctrl=new AbortController();const tid=setTimeout(()=>ctrl.abort(),TIMEOUT)\r\n      const r=await fetch('https://ps1images.stsci.edu/cgi-bin/ps1filenames.py?ra='+ra+'&dec='+dec+'&filters=grizy&type=stack&sep=,',{signal:ctrl.signal})\r\n      clearTimeout(tid)\r\n      const text=await r.text()\r\n      const lines=text.trim().split('\\n').slice(1)\r\n      for(const line of lines){const c=line.split(',');if(c.length>=8)files[c[4]?.trim()]=c[7]?.trim()}\r\n      state.imgCache[key]=files\r\n    }\r\n  }catch(err){\r\n    ph.textContent='Could not load images: '+(err?.message||'unknown')\r\n    el('filter-row').innerHTML=''\r\n    return\r\n  }\r\n\r\n  // Build color composite URL\r\n  if(files.r||files.g||files.i){\r\n    const params=['ra='+ra,'dec='+dec,'size='+size,'format=jpg']\r\n    if(files.i)params.push('red='+encodeURIComponent(files.i))\r\n    if(files.r)params.push('green='+encodeURIComponent(files.r))\r\n    if(files.g)params.push('blue='+encodeURIComponent(files.g))\r\n    const url='https://ps1images.stsci.edu/cgi-bin/fitscut.cgi?'+params.join('&')\r\n    imgEl.src=url\r\n    imgEl.onload=()=>{imgEl.style.display='';ph.style.display='none'}\r\n    imgEl.onerror=()=>{ph.textContent='Color image unavailable';imgEl.style.display='none';ph.style.display=''}\r\n  }else{\r\n    ph.textContent='No images available at this position'\r\n  }\r\n\r\n  // Individual filter thumbnails\r\n  const filterLetters=['g','r','i','z','y']\r\n  const filterColors={g:'#6366f1',r:'#22c55e',i:'#eab308',z:'#f97316',y:'#ef4444'}\r\n  el('filter-row').innerHTML=filterLetters.map(f=>{\r\n    if(!files[f])return ''\r\n    const url='https://ps1images.stsci.edu/cgi-bin/fitscut.cgi?ra='+ra+'&dec='+dec+'&size='+Math.min(size,480)+'&format=jpg&red='+encodeURIComponent(files[f])\r\n    return `<div class=\"filter-thumb-wrap\">\r\n      <img class=\"filter-thumb\" src=\"${url}\" alt=\"${f}-band\" onerror=\"this.style.display='none'\" />\r\n      <span class=\"filter-label\" style=\"color:${filterColors[f]}\">${f}</span>\r\n    </div>`\r\n  }).join('')||'<span style=\"font-size:11px;color:var(--dim)\">No individual band images</span>'\r\n}\r\n\r\n/* Size slider */\r\nel('size-slider').addEventListener('input',function(){\r\n  state.cutoutSize=parseInt(this.value)\r\n  const arcmin=(state.cutoutSize*0.25/60).toFixed(1)\r\n  el('size-label').textContent=state.cutoutSize+'px · '+arcmin+\"'\"\r\n})\r\nel('size-slider').addEventListener('change',function(){\r\n  state.cutoutSize=parseInt(this.value)\r\n  const obj=state.rows[state.selectedIdx]\r\n  if(obj)loadImages(parseFloat(obj.raMean),parseFloat(obj.decMean))\r\n})\r\n\r\n/* ---- Utility ---- */\r\nfunction pf(v){return v!=null?parseFloat(v).toFixed(4):'?'}\r\nfunction nn(v){return v!=null?v:'0'}\r\nfunction setStatus(msg,kind){const s=el('search-status');s.textContent=msg;s.className=kind||''}\r\nfunction disableSearch(d){el('search-btn').disabled=d;el('search-input').disabled=d}\r\nfunction showPlaceholder(msg){el('detail-placeholder').style.display='';el('detail-placeholder').textContent=msg;el('detail-content').style.display='none'}\r\n</script>\r\n</body>\r\n</html>\r\n"
}